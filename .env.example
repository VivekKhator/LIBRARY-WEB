# Copy to .env (optional - every value has a safe default)
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# 32+ char secret used to sign session cookies. Auto-generated per-boot if unset.
SESSION_SECRET=change-me-to-a-long-random-string
DB_PATH=./data/library.db
UPLOAD_DIR=./data/uploads
LOG_LEVEL=info
